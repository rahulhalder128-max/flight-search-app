# =============================================================================
# Flight Search Application - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# ============ Required ============

# Skypicker Aviation API Key
# Sign up at https://skiptrace.com/ to get your free API key
SKYPICKER_API_KEY=your_skypicker_api_key_here

# MongoDB Connection String
# Get from https://www.mongodb.com/cloud/cluster
# Format: mongodb+srv://username:password@cluster0.xxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017/flight_search

# ============ Optional ============

# Node Environment (development | production | test)
NODE_ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# Port
PORT=4000

# ============ API Configuration ============

# Skypicker API Base URL
SKYPICKER_BASE_URL=https://api.skypicker.com

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# ============ Rate Limiting ============

# Max requests per window (ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100